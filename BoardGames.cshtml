@page
@model BoardGamesModel

@{
    ViewData["Title"] = "Társasjátékok";
}

<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <h1 class="mt-4">@ViewData["Title"]</h1>

        <h3 class="mt-4">Társasjátékok listája</h3>
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Név</th>
                    <th>Játékosok száma</th>
                    <th>Játékidő (perc)</th>
                    <th>Ajánlott életkor</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var game in Model.BoardGames)
                {
                    <tr>
                        <td>@game.Id</td>
                        <td>@game.Name</td>
                        <td>@game.Players</td>
                        <td>@game.PlayTime</td>
                        <td>@game.RecommendedAge</td>
                    </tr>
                }
            </tbody>
        </table>

        <h3 class="mt-4">Új játék hozzáadása</h3>
        <form method="post">
            <div class="mb-3">
                <label for="Name" class="form-label">Játék neve</label>
                <input type="text" class="form-control" id="Name" name="NewGame.Name" required />
            </div>

            <div class="mb-3">
                <label for="Players" class="form-label">Játékosok száma</label>
                <input type="number" class="form-control" id="Players" name="NewGame.Players" required />
            </div>

            <div class="mb-3">
                <label for="PlayTime" class="form-label">Játékidő (perc)</label>
                <input type="number" class="form-control" id="PlayTime" name="NewGame.PlayTime" required />
            </div>

            <div class="mb-3">
                <label for="RecommendedAge" class="form-label">Ajánlott életkor</label>
                <input type="number" class="form-control" id="RecommendedAge" name="NewGame.RecommendedAge" required />
            </div>

            <button type="submit" class="btn btn-primary">Játék hozzáadása</button>
        </form>

        @if (!Model.ModelState.IsValid)
        {
            <div class="alert alert-danger mt-3" role="alert">
                Kérem, ellenőrizze a beviteli mezőket!
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
